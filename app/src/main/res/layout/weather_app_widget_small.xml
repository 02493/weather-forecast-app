<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="10dp">
    <TextView android:id="@+id/cityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/city_moscow" android:textColor="@color/widget_secondary" android:textSize="12sp" android:letterSpacing="0.08" android:includeFontPadding="false" android:maxLines="1"/>
    <TextView android:id="@+id/weatherText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-light" android:text="@string/temperature_placeholder" android:textColor="@color/widget_text" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="42sp" android:autoSizeStepGranularity="2sp" android:maxLines="1"/>
    <TextView android:id="@+id/updatedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weather_unavailable" android:textColor="@color/widget_secondary" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
    <Button android:id="@+id/updateWidgetButton" android:layout_width="match_parent" android:layout_height="48dp" android:minHeight="48dp" android:padding="0dp" android:background="@drawable/widget_button" android:text="@string/widget_update" android:textColor="@color/accent" android:textAllCaps="false" android:textSize="12sp"/>
</LinearLayout>
