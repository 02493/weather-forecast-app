<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/planet" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Meteo.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/brand_name"
                android:textColor="@color/paper" />

            <ImageButton
                android:id="@+id/notificationSettingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_notifications"
                android:padding="14dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/muted" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/refreshButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/refresh_weather"
                    android:padding="13dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/paper" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/ice"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/cityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:letterSpacing="-0.035"
            android:text="@string/city_title"
            android:textColor="@color/paper"
            android:textSize="58sp" />

        <TextView
            style="@style/Meteo.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/current_label"
            android:textColor="@color/ice" />

        <TextView
            android:id="@+id/temperatureText"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:autoSizeMaxTextSize="116sp"
            android:autoSizeMinTextSize="64sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-thin"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="-0.065"
            android:maxLines="1"
            android:text="@string/degree_placeholder"
            android:textColor="@color/paper" />

        <TextView
            android:id="@+id/forecastText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/weather_unavailable"
            android:textColor="@color/paper"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/updatedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/forecastPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Meteo.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hourly_label"
                android:textColor="@color/paper" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hourOneTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forecast_time_placeholder"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/hourOneTemperature"
                        style="@style/Meteo.ForecastValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/degree_placeholder" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hour_one"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="20dp"
                    android:background="@color/outline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hourTwoTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forecast_time_placeholder"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/hourTwoTemperature"
                        style="@style/Meteo.ForecastValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/degree_placeholder"
                        android:textColor="@color/accent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hour_two"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createNotificationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0"
            android:minHeight="60dp"
            android:text="@string/create_notification"
            android:textColor="@color/ink"
            android:textSize="14sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_bell"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/updateWidgetButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0"
            android:minHeight="60dp"
            android:text="@string/update_widget_data"
            android:textColor="@color/paper"
            android:textSize="14sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_grid"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/ice"
            app:strokeColor="@color/outline" />

        <TextView
            android:id="@+id/statusText"
            style="@style/Meteo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:drawablePadding="9dp"
            android:text="@string/start_loading"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/status_dot" />

        <TextView
            style="@style/Meteo.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.04"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
